{
  "skill_id": "de_dev_05_sk01",
  "name": "平台格式适配",
  "type": "atomic",
  "input": {
    "type": "object",
    "required": [
      "content",
      "target"
    ],
    "properties": {
      "content": {
        "type": "string",
        "description": "原文：需要改写的完整文本"
      },
      "target": {
        "type": "string",
        "description": "目标要求：目标平台/目标风格/字数限制"
      },
      "platform": {
        "type": "string",
        "description": "目标平台：平台名（可选）"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "adapted",
      "changes",
      "constraints"
    ],
    "properties": {
      "adapted": {
        "type": "string",
        "description": "改写后的完整文本"
      },
      "changes": {
        "type": "array",
        "description": "逐条说明改了什么、为什么",
        "items": {
          "type": "object",
          "properties": {
            "#": {
              "type": "string"
            },
            "原文要点": {
              "type": "string"
            },
            "改动后": {
              "type": "string"
            },
            "改动理由": {
              "type": "string"
            }
          }
        }
      },
      "constraints": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "字数/标签数等硬约束的达标情况与依据"
      }
    },
    "x-rendered-from": "capability:adapt"
  },
  "constraints": {
    "max_input_length": 5000,
    "forbidden_words": [
      "最好",
      "第一",
      "100%"
    ],
    "ai_label_required": true,
    "human_review_required": true,
    "external_api_required": false
  }
}