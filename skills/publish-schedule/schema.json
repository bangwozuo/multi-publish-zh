              "type": "string"
            },
            "时间": {
              "type": "string"
            },
            "内容": {
              "type": "string"
            },
            "平台": {
              "type": "string"
            },
            "状态": {
              "type": "string"
            }
          }
        }
      },
      "conflicts": {
        "type": "array",
